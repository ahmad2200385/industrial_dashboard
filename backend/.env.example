APP_NAME=Smart Factory API
APP_VERSION=2.0.0
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/smart_factory

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

ALERT_TEMPERATURE_THRESHOLD=80
AUTO_CREATE_SCHEMA=false
ALERT_INFO_TTL_SECONDS=900
ALERT_WARNING_TTL_SECONDS=1800
ALERT_CRITICAL_TTL_SECONDS=3600
ALERT_EXPIRY_SWEEP_SECONDS=15
